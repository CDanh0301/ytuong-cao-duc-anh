<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Test2" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Disable system-level Force Dark (Android 10+) so OS cannot invert canvas colors -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <!-- Ensure system status bar and navigation bar have dark icons on light background -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
</resources>
