<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude all sensitive local files, SQLite databases, and SharedPreferences from cloud backup -->
        <exclude domain="file" path="photos"/>
        <exclude domain="file" path="photo_manager_metadata.json.enc"/>
        <exclude domain="file" path="photo_manager_metadata.json"/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <!-- Exclude all sensitive local files, SQLite databases, and SharedPreferences from D2D transfer -->
        <exclude domain="file" path="photos"/>
        <exclude domain="file" path="photo_manager_metadata.json.enc"/>
        <exclude domain="file" path="photo_manager_metadata.json"/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>